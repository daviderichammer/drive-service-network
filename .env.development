# Drive Service Network — Development Environment
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database (local Docker MySQL)
DATABASE_URL="mysql://dsn_user:dsn_password@localhost:3306/drive_service_network_dev"

# Redis (local Docker Redis)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------
# Openbay PLATFORM API — staging (server-side only, NEVER expose to client)
# The Partner API has been removed entirely (REVAMP BUILD section 2).
# ------------------------------------------------------------------
OPENBAY_PLATFORM_API_BASE_URL="https://api-staging.openbay.com"
OPENBAY_PLATFORM_API_KEY="pk_test_XCK9YghotafQzlTVfwNuny0dQ9Ik-ctHmjsR944RWTE"
OPENBAY_PLATFORM_PARTNER_ID="116"
OPENBAY_PLATFORM_ENVIRONMENT="staging"

# ------------------------------------------------------------------
# DSN Membership Google Sheet — awaiting sheet from Mitch (FLAG F-9).
# Registrations are queued in MembershipSyncLog until this is populated.
# ------------------------------------------------------------------
DSN_MEMBERSHIP_SHEET_ID=""
DSN_MEMBERSHIP_SHEET_TAB="Members"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-change-in-production-min-32-chars"
AUTH_SECRET="dev-nextauth-secret-change-in-production-min-32-chars"
AUTH_TRUST_HOST=true

# Internal API
INTERNAL_API_SECRET="dev-internal-secret-change-in-production"

# Email (Mailhog / local catcher)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@driveservicenetwork.com"
EMAIL_FROM_NAME="Drive Service Network"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Feature Flags
NEXT_PUBLIC_FEATURE_MEMBERSHIP=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_FLEET_PORTAL=false
NEXT_PUBLIC_FEATURE_FINANCING=false
