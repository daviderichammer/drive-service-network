# Drive Service Network — Production Environment
# ALL VALUES MUST BE SET VIA CI/CD SECRETS — DO NOT HARDCODE

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://driveservicenetwork.com
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database (production MySQL — set via CI/CD secret)
DATABASE_URL="mysql://dsn_user:PRODUCTION_SECRET@prod-db.driveservicenetwork.com:3306/drive_service_network"

# Redis (production Redis — set via CI/CD secret)
REDIS_URL="redis://prod-redis.driveservicenetwork.com:6379"

# Openbay API — Production (server-side only, NEVER expose to client)
OPENBAY_API_BASE_URL="https://services-staging.openbay.com"
OPENBAY_PARTNER_ID="116"
OPENBAY_API_KEY="ob_1aef221608de6e2ea25ec111bc89de20fc165987167516d2667740cc3164041c97263d938c0d990153899044e9ced52aafa38a2f219eac25e5e98f2d64136324"
OPENBAY_ENVIRONMENT="staging"

# NextAuth.js (Phase 3)
NEXTAUTH_URL="https://driveservicenetwork.com"
NEXTAUTH_SECRET="I+ukgNtme4dF5YEUJBsth4kaoEvAvyBHzfSAk76HF3e0"
