# Drive Service Network — Production Environment TEMPLATE
#
# This file is a template only. The live file on the server
# (/opt/drive-service-network/.env.production) holds the real secrets and is
# never committed. Copy this template, fill in every CHANGE_ME, and restart
# the systemd unit.
#
# REVAMP BUILD section 2: the Openbay Partner API is obsolete. Any surviving
# OPENBAY_API_BASE_URL / OPENBAY_API_KEY / OPENBAY_PARTNER_ID entries in the
# live environment file must be DELETED — they are no longer read by the app.

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://driveservicenetwork.com
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database
DATABASE_URL="mysql://dsn_user:CHANGE_ME@localhost:3306/drive_service_network"

# Redis
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------
# Openbay PLATFORM API (server-side only, NEVER expose to the client)
#
# Production requires a pk_live_ key and the production base URL from Openbay.
# Until Openbay issues them (FLAG F-10), production continues to point at
# staging, which means live members would be created in Openbay's staging
# tenant. Do NOT go live with real customers on these values.
# ------------------------------------------------------------------
OPENBAY_PLATFORM_API_BASE_URL="https://api-staging.openbay.com"
OPENBAY_PLATFORM_API_KEY="CHANGE_ME_PRODUCTION_KEY"
OPENBAY_PLATFORM_PARTNER_ID="116"
OPENBAY_PLATFORM_ENVIRONMENT="staging"

# ------------------------------------------------------------------
# DSN Membership Google Sheet — awaiting sheet from Mitch (FLAG F-9)
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY must keep its literal \n escapes.
# ------------------------------------------------------------------
DSN_MEMBERSHIP_SHEET_ID=""
DSN_MEMBERSHIP_SHEET_TAB="Members"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# NextAuth.js
NEXTAUTH_URL="https://driveservicenetwork.com"
NEXTAUTH_SECRET="CHANGE_ME_MIN_32_CHARS"
AUTH_SECRET="CHANGE_ME_MIN_32_CHARS"
AUTH_TRUST_HOST=true

# Internal API (protects /api/admin/* and /api/platform/health)
INTERNAL_API_SECRET="CHANGE_ME"

# Email
SMTP_HOST="CHANGE_ME"
SMTP_PORT="587"
SMTP_USER="CHANGE_ME"
SMTP_PASS="CHANGE_ME"
EMAIL_FROM="noreply@driveservicenetwork.com"
EMAIL_FROM_NAME="Drive Service Network"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Feature Flags
NEXT_PUBLIC_FEATURE_MEMBERSHIP=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_FLEET_PORTAL=false
NEXT_PUBLIC_FEATURE_FINANCING=false

# Server
PORT=3049
