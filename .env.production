# Drive Service Network — Production Environment
# ALL VALUES MUST BE SET VIA CI/CD SECRETS — DO NOT HARDCODE

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://driveservicenetwork.com
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database (production MySQL — set via CI/CD secret)
DATABASE_URL="mysql://dsn_user:PRODUCTION_SECRET@prod-db.driveservicenetwork.com:3306/drive_service_network"

# Redis (production Redis — set via CI/CD secret)
REDIS_URL="redis://prod-redis.driveservicenetwork.com:6379"

# Openbay API — Production (server-side only, NEVER expose to client)
OPENBAY_API_BASE_URL="https://api.openbay.com"
OPENBAY_PARTNER_ID="116"
OPENBAY_API_KEY="PRODUCTION_SECRET"
OPENBAY_ENVIRONMENT="production"

# NextAuth.js (Phase 3)
NEXTAUTH_URL="https://driveservicenetwork.com"
NEXTAUTH_SECRET="PRODUCTION_SECRET"
AUTH_SECRET="PRODUCTION_SECRET"

# Internal API
INTERNAL_API_SECRET="PRODUCTION_SECRET"

# Email
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="PRODUCTION_SECRET"
EMAIL_FROM="noreply@driveservicenetwork.com"
EMAIL_FROM_NAME="Drive Service Network"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="PRODUCTION_GA_ID"
NEXT_PUBLIC_GTM_ID="PRODUCTION_GTM_ID"

# Feature Flags
NEXT_PUBLIC_FEATURE_MEMBERSHIP=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_FLEET_PORTAL=true
NEXT_PUBLIC_FEATURE_FINANCING=true
