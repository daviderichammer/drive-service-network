// Drive Service Network — Prisma Schema
// Global Drive Holdings Inc.
//
// REVAMP BUILD — Priority 1 (Foundation)
//
// DSN's application database is the SYSTEM OF RECORD for members, vehicles,
// membership status, quotes, appointments, repair history, messages and DSN+
// status (BUILD section 8). Openbay is infrastructure; the Google Sheet is an
// operational mirror, never the database.
//
// Key architectural rules encoded here:
//   - MEMBER -> VEHICLE -> DSN+ ENROLMENT (BUILD "Discount eligibility must
//     follow the vehicle"). Enrolment is NEVER a flag on the member.
//   - VIN is the principal persistent vehicle identifier (BUILD section L).
//   - Historical data is preserved via status fields, never destructive
//     deletion (BUILD section K).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  FLEET_OPERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// BUILD section J — MEMBER STATUS is separate from VEHICLE STATUS.
/// A member is FREE or DSN_PLUS; DSN_PLUS means at least one of their vehicles
/// is enrolled in the paid discount programme. It never by itself entitles a
/// vehicle to discounted pricing.
enum MembershipTier {
  FREE
  DSN_PLUS
}

enum FleetType {
  TURO_HOST
  RENTAL_OPERATOR
  COMMERCIAL_FLEET
  DEALER
  CORPORATE
  MUNICIPAL
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  IN_SERVICE
  SOLD
  REMOVED
}

/// BUILD "Critical business rule — free registered vehicles vs. discount-program
/// enrolled vehicles". Every registered vehicle is FREE; only vehicles the
/// member specifically enrols become DSN_PLUS.
enum VehicleProgramStatus {
  FREE
  DSN_PLUS
}

/// BUILD section Q — DSN+ must not be a permanent yes/no field.
enum SubscriptionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum DsnPlusPaymentPlan {
  PREPAID_6
  PREPAID_12
  FINANCE_12
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServiceRequestStatus {
  DRAFT
  OPEN_FOR_OFFERS
  ACCEPTED
  SETTLED
  EXPIRED
  WITHDRAWN
}

enum ContactFormStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

/// Direction of a facility conversation message (BUILD section 25).
/// The Platform API publishes no messaging surface (FLAG F-7), so Drive
/// Service Network operates the conversation itself and relays to the facility.
enum MessageDirection {
  MEMBER_TO_FACILITY
  FACILITY_TO_MEMBER
  DSN_TO_MEMBER
}

enum MessageThreadStatus {
  OPEN
  AWAITING_FACILITY
  AWAITING_MEMBER
  CLOSED
}

/// Support conversations that are not tied to a specific facility.
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_MEMBER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Google Sheet mirror state (BUILD section 8, TEST L).
enum SheetSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

// ============================================================
// MEMBERS
// ============================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerified     DateTime?
  firstName         String
  lastName          String
  phone             String?
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)

  /// Derived: DSN_PLUS when the member has at least one actively enrolled
  /// vehicle. Never used on its own to price a repair.
  membershipTier    MembershipTier @default(FREE)
  memberSince       DateTime   @default(now())

  // Auth
  password          String?

  // Company / fleet profile captured at registration (BUILD section 7)
  companyName       String?
  operatorType      String?
  fleetSizeBand     String?
  primaryMarket     String?

  /// Openbay Platform API driver id (users.users.id). DSN persists this so it
  /// can always read Openbay by id — the partner-scoped list endpoints do not
  /// return API-key-created records (FLAGS F-3).
  openbayUserId     String?    @unique
  openbayLegacyId   String?

  // Address
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  zipCode           String?
  country           String?    @default("US")

  // Google Sheet mirror
  sheetSyncStatus   SheetSyncStatus @default(PENDING)
  sheetSyncedAt     DateTime?
  sheetSyncError    String?    @db.Text
  sheetRowRef       String?

  // Metadata
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?

  // Relations
  vehicles          Vehicle[]
  fleets            FleetMember[]
  appointments      Appointment[]
  serviceRequests   ServiceRequest[]
  enrollments       VehicleEnrollment[]
  contactForms      ContactForm[]
  accounts          Account[]
  sessions          Session[]
  financingInquiries FinancingInquiry[]
  funnelEvents      FunnelEvent[]
  messageThreads    MessageThread[]
  supportTickets    SupportTicket[]

  @@index([email])
  @@index([openbayUserId])
  @@index([membershipTier])
  @@map("users")
}

// ============================================================
// NEXTAUTH
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// VEHICLES
// ============================================================

model Vehicle {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleetId       String?
  fleet         Fleet?        @relation(fields: [fleetId], references: [id])

  // BUILD section 9 — the seven required attributes
  year          Int
  make          String
  model         String
  /// NOT SUPPORTED BY THE PLATFORM API — DSN-local only (FLAGS F-4).
  color         String?
  /// Platform API has no discrete engine field; derived from styleName and/or
  /// captured from the member (FLAGS F-4).
  engine        String?
  /// Unique per member, not globally: the same vehicle can legitimately be
  /// sold between two DSN members, and a global constraint would permanently
  /// lock the VIN to the first account that registered it.
  vin           String?
  licensePlate  String?

  trim          String?
  mileage       Int?
  nickname      String?

  /// Where the vehicle is based. Openbay requires it when the vehicle is
  /// created, and DSN reuses it as the default service-search location so the
  /// member is not asked for the same ZIP twice (BUILD sections 9 and 13).
  zipCode       String?

  /// Openbay owned-vehicle id and resolved Edmunds style.
  openbayVehicleId String?    @unique
  openbayStyleId   Int?
  openbayStyleName String?

  status        VehicleStatus @default(ACTIVE)

  /// BUILD: every registered vehicle has FREE membership = YES. This column
  /// records whether THIS vehicle is enrolled in the paid discount programme.
  programStatus VehicleProgramStatus @default(FREE)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Soft-removal timestamp — history is preserved (BUILD section K).
  removedAt     DateTime?

  appointments    Appointment[]
  serviceRequests ServiceRequest[]
  enrollments     VehicleEnrollment[]
  repairHistory   RepairHistory[]
  messageThreads  MessageThread[]
  recalls         VehicleRecall[]

  @@unique([userId, vin], name: "vehicle_member_vin")
  @@index([userId])
  @@index([fleetId])
  @@index([vin])
  @@index([programStatus])
  @@map("vehicles")
}

// ============================================================
// DSN+ VEHICLE ENROLMENT
// ============================================================

/// BUILD "Vehicle-specific enrollment date + billing date": each enrolled
/// vehicle carries its own enrolment date, effective date, billing date,
/// payment plan, subscription status and renewal date. Vehicles enrolled on
/// different dates keep different billing anniversaries and are never
/// automatically prorated onto a common date.
model VehicleEnrollment {
  id                String   @id @default(cuid())

  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  /// VIN captured at enrolment. Discount eligibility follows the VIN
  /// (BUILD section L) and must survive edits to the vehicle record.
  vinAtEnrollment   String?

  plan              DsnPlusPaymentPlan
  status            SubscriptionStatus @default(PENDING_PAYMENT)

  enrollmentDate    DateTime  @default(now())
  effectiveDate     DateTime?
  /// Billing anniversary — same numerical day each month as enrolment.
  nextBillingDate   DateTime?
  expirationDate    DateTime?
  cancelledAt       DateTime?

  /// Fleet tier and unit price captured at the time of this charge. Pricing is
  /// prospective only — previously completed periods are never recalculated
  /// (BUILD "No retroactive recalculation").
  fleetTierId       String?
  monthlyPerVehicleCents Int?
  /// Count of the member's ACTIVE enrolled vehicles at the moment of the
  /// snapshot that produced the tier above.
  activeVehicleCountAtSnapshot Int?

  /// Populated only once David confirms the payment architecture
  /// (BUILD section P, FLAGS F-9). No payment processing exists in P1.
  paymentReference  String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("vehicle_enrollments")
}

// ============================================================
// FLEETS
// ============================================================

model Fleet {
  id              String      @id @default(cuid())
  name            String
  type            FleetType   @default(OTHER)
  description     String?     @db.Text

  contactName     String?
  contactEmail    String?
  contactPhone    String?

  addressLine1    String?
  city            String?
  state           String?
  zipCode         String?

  dotNumber       String?
  taxId           String?
  vehicleCount    Int?        @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  members         FleetMember[]
  vehicles        Vehicle[]
  appointments    Appointment[]

  @@index([type])
  @@map("fleets")
}

model FleetMember {
  id        String   @id @default(cuid())
  fleetId   String
  fleet     Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([fleetId, userId])
  @@map("fleet_members")
}

// ============================================================
// SERVICE REQUESTS / QUOTES (Priority 2 groundwork)
// ============================================================

/// BUILD section 31 — MEMBER -> VEHICLE -> SERVICE REQUEST -> FACILITY
/// ESTIMATES -> APPOINTMENT -> REPAIR HISTORY. Modelled now so Priority 2 has
/// somewhere to write, without any fabricated data.
model ServiceRequest {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  vehicleId             String
  vehicle               Vehicle  @relation(fields: [vehicleId], references: [id])

  /// Openbay service-request id and public openbay id.
  openbayServiceRequestId String? @unique
  openbayPublicId       String?

  status                ServiceRequestStatus @default(DRAFT)

  /// Service location — NOT assumed to be the member's company address
  /// (BUILD section 13).
  serviceZipCode        String
  serviceCity           String?
  serviceState          String?

  /// Requested services with the Platform API interview answers, stored as
  /// returned/submitted. DSN does not author its own interview logic
  /// (BUILD section 12).
  requestedServices     Json?
  interviewAnswers      Json?
  notes                 String?  @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  appointments          Appointment[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@map("service_requests")
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id])
  fleetId           String?
  fleet             Fleet?            @relation(fields: [fleetId], references: [id])
  serviceRequestId  String?
  serviceRequest    ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])

  serviceType       String
  serviceDescription String?          @db.Text

  /// Price the accepted offer was booked at. This is NOT a final invoiced
  /// amount — the Platform API exposes no settlement payload (FLAGS F-6).
  quotedPriceCents  Int?
  finalPriceCents   Int?
  dsnPlusSavingsCents Int?

  shopName          String?
  shopAddress       String?
  shopCity          String?
  shopState         String?
  shopZipCode       String?
  shopPhone         String?
  shopRating        Decimal?          @db.Decimal(3, 2)

  scheduledAt       DateTime?
  completedAt       DateTime?
  status            AppointmentStatus @default(PENDING)

  openbayAppointmentId String?
  openbayOfferId       String?
  openbayLocationId    String?

  customerNotes     String?           @db.Text

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  messageThreads    MessageThread[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

// ============================================================
// REPAIR HISTORY (BUILD sections 25 and R)
// ============================================================

model RepairHistory {
  id                String    @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])

  /// Retained even when the vehicle is removed from the fleet
  /// (BUILD section K).
  vin               String?

  serviceDate       DateTime?
  workPerformed     String?   @db.Text
  facilityName      String?
  facilityCity      String?
  facilityState     String?

  quotedPriceCents  Int?
  finalPriceCents   Int?
  dsnPlusSavingsCents Int?

  openbayServiceRequestId String?
  openbayAppointmentId    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vehicleId])
  @@index([vin])
  @@map("repair_history")
}

// ============================================================
// FACILITY MESSAGING (BUILD section 25)
//
// FLAG F-7: the Openbay Platform API publishes no messaging endpoints — the
// full 41-path specification was audited and contains none. Drive Service
// Network therefore owns the conversation itself: the member writes to the
// facility through DSN, and DSN relays and records the exchange. This keeps
// the member inside the DSN brand and preserves the record in DSN's own
// system, which is the system of record (BUILD section 8).
// ============================================================

model MessageThread {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?            @relation(fields: [vehicleId], references: [id])
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])

  subject       String
  /// Facility identity captured at the time of writing, so the thread remains
  /// readable even if the facility later leaves the network.
  facilityName  String?
  facilitySlug  String?
  facilityPhone String?

  status        MessageThreadStatus @default(OPEN)
  lastMessageAt DateTime            @default(now())
  unreadForMember Int               @default(0)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  messages      Message[]

  @@index([userId])
  @@index([appointmentId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("message_threads")
}

model Message {
  id         String           @id @default(cuid())
  threadId   String
  thread     MessageThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  direction  MessageDirection
  body       String           @db.Text
  /// Display name of the author as the member should see it.
  authorName String?
  readAt     DateTime?

  createdAt  DateTime         @default(now())

  @@index([threadId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================================
// SUPPORT (BUILD section 26)
// ============================================================

model SupportTicket {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])

  subject     String
  category    String?
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)

  /// Context the member was in when they asked for help, so the DSN team does
  /// not have to ask them to repeat it.
  relatedAppointmentId String?
  relatedVehicleId     String?

  lastMessageAt DateTime            @default(now())
  resolvedAt    DateTime?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages    SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromMember Boolean       @default(true)
  authorName String?
  body       String        @db.Text
  readAt     DateTime?

  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================
// SAFETY RECALLS (BUILD section 24)
//
// FLAG: the Platform API exposes no recall data. DSN sources open recalls from
// the U.S. National Highway Traffic Safety Administration, the authoritative
// public record, and caches the result per vehicle so the dashboard is fast and
// the member is not exposed to an upstream outage.
// ============================================================

model VehicleRecall {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// NHTSA campaign number — the stable public identifier for the recall.
  campaignNumber  String
  component       String?  @db.Text
  summary         String?  @db.Text
  consequence     String?  @db.Text
  remedy          String?  @db.Text
  manufacturer    String?
  reportReceivedDate DateTime?

  /// Member-managed acknowledgement. DSN never asserts that a recall has been
  /// performed; only the member or the facility can say that.
  acknowledgedAt  DateTime?

  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([vehicleId, campaignNumber])
  @@index([vehicleId])
  @@map("vehicle_recalls")
}

// ============================================================
// ANALYTICS (BUILD sections 37 and T)
// ============================================================

model FunnelEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  /// e.g. join_free_clicked, membership_completed, first_vehicle_added,
  /// quote_started, dsn_plus_enrollment_completed
  event     String
  metadata  Json?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@map("funnel_events")
}

// ============================================================
// GOOGLE SHEET SYNC LOG (BUILD section 8, TEST L)
// ============================================================

model SheetSyncLog {
  id          String          @id @default(cuid())
  entityType  String
  entityId    String
  operation   String
  status      SheetSyncStatus
  attempt     Int             @default(1)
  errorMessage String?        @db.Text
  payload     Json?
  createdAt   DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([status])
  @@map("sheet_sync_log")
}

// ============================================================
// LEADS
// ============================================================

model ContactForm {
  id          String            @id @default(cuid())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id])

  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?

  subject     String
  message     String            @db.Text
  inquiryType String?

  status      ContactFormStatus @default(NEW)
  assignedTo  String?
  resolvedAt  DateTime?
  notes       String?           @db.Text

  ipAddress   String?
  userAgent   String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@map("contact_forms")
}

model FinancingInquiry {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])

  firstName     String
  lastName      String
  email         String
  phone         String?
  company       String?

  fleetSize     String?
  financingNeed String?
  estimatedAmount Decimal? @db.Decimal(10, 2)
  notes         String?  @db.Text

  status        String   @default("NEW")
  assignedTo    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("financing_inquiries")
}

// ============================================================
// SERVICE CATALOG CACHE (from the Platform API)
// ============================================================

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  iconName    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  openbayCategoryId Int? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@map("service_categories")
}

model Service {
  id              String          @id @default(cuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])

  name            String
  description     String?         @db.Text
  openbayServiceId Int?           @unique
  autoquotable    Boolean         @default(false)

  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([openbayServiceId])
  @@map("services")
}
