# Drive Service Network — QA / Openbay Staging Environment
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.driveservicenetwork.com
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database (staging MySQL)
DATABASE_URL="mysql://dsn_user:REPLACE_WITH_STAGING_PASSWORD@staging-db.driveservicenetwork.com:3306/drive_service_network_staging"

# Redis (staging Redis)
REDIS_URL="redis://staging-redis.driveservicenetwork.com:6379"

# Openbay API — Staging Partner #116
# API Key format: ob_xxxxxxxxxxxxxxxx (provided by Openbay)
OPENBAY_API_BASE_URL="https://services-staging.openbay.com"
OPENBAY_PARTNER_ID="116"
OPENBAY_API_KEY="REPLACE_WITH_STAGING_API_KEY"
OPENBAY_ENVIRONMENT="staging"

# Internal API
INTERNAL_API_SECRET="REPLACE_WITH_STAGING_INTERNAL_SECRET"

# Email
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="REPLACE_WITH_SENDGRID_API_KEY"
EMAIL_FROM="noreply@driveservicenetwork.com"
EMAIL_FROM_NAME="Drive Service Network"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="REPLACE_WITH_GA_ID"
NEXT_PUBLIC_GTM_ID=""

# Feature Flags
NEXT_PUBLIC_FEATURE_MEMBERSHIP=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_FLEET_PORTAL=true
NEXT_PUBLIC_FEATURE_FINANCING=false
