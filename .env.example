# Drive Service Network — Environment Variables Example
# Copy this file to .env.local and fill in your values.
#
# REVAMP BUILD section 2: the Openbay PARTNER API is obsolete and has been
# removed from this codebase in its entirety. All OPENBAY_API_* variables are
# gone. Only the OPENBAY_PLATFORM_* variables below are used.

NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Drive Service Network"
NEXT_PUBLIC_APP_TAGLINE="Built by Operators. Designed for Operators."

# Database
DATABASE_URL="mysql://dsn_user:dsn_password@localhost:3306/drive_service_network_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------
# Openbay PLATFORM API (server-side only — NEVER expose to the client)
# ------------------------------------------------------------------
# Staging base URL:    https://api-staging.openbay.com
# Production base URL: request from Openbay
# Key format:          pk_test_… (staging) / pk_live_… (production)
OPENBAY_PLATFORM_API_BASE_URL="https://api-staging.openbay.com"
OPENBAY_PLATFORM_API_KEY="pk_test_your_key_here"
OPENBAY_PLATFORM_PARTNER_ID="116"
OPENBAY_PLATFORM_ENVIRONMENT="staging"

# ------------------------------------------------------------------
# DSN Membership Google Sheet (operational mirror — NOT the database)
# ------------------------------------------------------------------
# Sheet id is the long identifier in the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Leave blank until Mitch supplies the sheet. Members registered in the interim
# are queued and can be replayed with POST /api/admin/sheet-sync.
DSN_MEMBERSHIP_SHEET_ID=""
DSN_MEMBERSHIP_SHEET_TAB="Members"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-min-32-chars"
AUTH_SECRET="change-me-min-32-chars"
AUTH_TRUST_HOST=true

# Internal API (protects /api/admin/* and /api/platform/health)
INTERNAL_API_SECRET="your-internal-secret-here"

# Email
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@driveservicenetwork.com"
EMAIL_FROM_NAME="Drive Service Network"

# Analytics (optional in development)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Feature Flags
NEXT_PUBLIC_FEATURE_MEMBERSHIP=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_FLEET_PORTAL=false
NEXT_PUBLIC_FEATURE_FINANCING=false
